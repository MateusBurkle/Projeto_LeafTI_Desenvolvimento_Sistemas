# Exemplo de variáveis de ambiente do LEAF TI. A aplicação lê o ambiente do terminal (não carrega .env sozinha): defina cada variável no terminal. NÃO coloque valores reais aqui.

# 'desenvolvimento' (padrão) ou 'producao'. Em produção a carga de demonstração se recusa a rodar.
LEAF_AMBIENTE=desenvolvimento

# Segredo usado para assinar o token JWT. Use um texto longo e aleatório. Obrigatório em produção.
LEAF_JWT_SECRET=

# Caminho do arquivo SQLite (padrão: backend/leaf_ti.db).
LEAF_DB_PATH=

# Origens permitidas no CORS, separadas por vírgula (padrão: localhost).
LEAF_CORS_ORIGINS=

# Validade do token em minutos (padrão: 60).
LEAF_TOKEN_MINUTOS=60

# Pasta das imagens enviadas dos equipamentos (padrão: armazenamento/imagens/equipamentos).
LEAF_IMAGENS_DIR=

# Pasta das telas (front-end) servidas pela API (padrão: frontend/).
LEAF_FRONTEND_DIR=
